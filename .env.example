# Supabase project credentials (Project Settings → API in the Supabase dashboard).
# Copy this file to `.env.local` and fill in the values. `.env*.local` is gitignored.
# The anon/publishable key is safe to ship in the client bundle — per-user isolation
# is enforced by Row-Level Security, not by keeping this key secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: pin the auth magic-link redirect to a fixed public URL. Leave this
# unset for local dev (redirect falls back to the current origin). The deploy
# workflow sets it to the production Pages URL so links return to the live app.
# VITE_SITE_URL=https://hmugatu.github.io/Lyric-Chord-Composer/
