# Supabase project credentials (Project Settings → API in the Supabase dashboard).
# Copy this file to `.env.local` and fill in the values. `.env*.local` is gitignored.
# The anon/publishable key is safe to ship in the client bundle — per-user isolation
# is enforced by Row-Level Security, not by keeping this key secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
